# ---------------------------------------------------------------------------
# Vertrauliche Zugangsdaten. Kopieren nach .env und ausfuellen:
#   cp .env.example .env && chmod 600 .env
# .env wird NIE eingecheckt (siehe .gitignore).
# ---------------------------------------------------------------------------

# LLM-Backend: mindestens einer der beiden Keys wird gebraucht,
# passend zu llm.provider in config.yaml.
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Nur fuer sources.provider: api
# eBay Browse API (Verkaufsseite): https://developer.ebay.com -> Application
# Keys -> Production. "App ID (Client ID)" und "Cert ID (Client Secret)".
EBAY_APP_ID=
EBAY_CERT_ID=

# Amazon Creators API (Einkaufsseite, nur bei sources.api.purchase_source: amazon).
# Nachfolger der am 15.05.2026 abgeschalteten PA-API 5.0 -- alte AMAZON_PAAPI_*
# Keys funktionieren nicht mehr. Voraussetzung: freigeschalteter Associates-
# Account mit >=10 qualifizierten Verkaeufen in den letzten 30 Tagen.
# Credential-Version steht im Associates-Portal neben den Zugangsdaten (z. B. 2.2, 3.2).
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=
AMAZON_PARTNER_TAG=

# Optional: Drittanbieter-Datenanbieter (Keepa, Rainforest, ...) -- derzeit ungenutzt
SCRAPER_API_KEY=

# Optional: Benachrichtigungen ueber Treffer (scout.py --notify-telegram) und
# der Start/Stop-Listener (listener.py). Bot ueber @BotFather anlegen; die
# Chat-ID bekommt man z. B. ueber https://api.telegram.org/bot<TOKEN>/getUpdates
# nach einer ersten Nachricht an den Bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Pfad zur YAML-Konfiguration (Default: ./config.yaml)
SCOUT_CONFIG_FILE=config.yaml

# Optional: einzelne YAML-Werte ueberschreiben (doppelter Unterstrich = Ebene)
# SCOUT__MARGIN__MIN_ROI_PERCENT=30
# SCOUT__LOGGING__LEVEL=DEBUG
